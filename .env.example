# Copy to .env and fill in (only needed if you rebuild the app yourself).
# These are the same three values your Vercel project used.
# Find them in Supabase -> Project Settings -> API. Use the PUBLISHABLE / anon key only,
# never the service_role key.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
